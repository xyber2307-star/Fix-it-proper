# Fix It Proper backend config. Copy to .env and fill in. Never commit .env.
FRONTEND_ORIGIN=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PAGESPEED_API_KEY=
RATE_LIMIT_PER_HOUR=10
LOG_LEVEL=INFO
USE_PLAYWRIGHT=true
PLAYWRIGHT_NAVIGATION_TIMEOUT_S=15
FETCH_CACHE_TTL_SECONDS=3600
FETCH_CACHE_MAX_MB=64
# Reserved for later. Proxies are not used in v1.
PROXY_ENABLED=false
# Firebase. Use the emulator for local dev (see README). For production set
# the project id plus exactly one credential source. Never commit credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_BASE64=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
REPORT_RETENTION_DAYS=30
CONTACT_RATE_LIMIT_PER_HOUR=5
