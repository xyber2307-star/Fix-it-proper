# Copy to .env for local development. Never commit .env.
# Empty VITE_API_URL uses the dev proxy (see vite.config.ts) or same origin.
# In production set the backend origin with no trailing slash.
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Set to "true" to use the local Firebase emulators.
VITE_FIREBASE_USE_EMULATORS=
